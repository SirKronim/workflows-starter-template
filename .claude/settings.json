{
	"permissions": {
		"allow": [
			"Bash(npm test)",
			"Bash(npm run lint)",
			"Bash(npx tsc -b)",
			"Bash(npm audit)",
			"Bash(npm audit --omit=dev)",
			"Bash(git status)",
			"Bash(git diff *)",
			"Bash(git log *)"
		],
		"deny": [
			"Read(./.dev.vars*)",
			"Read(./.env*)"
		]
	},
	"hooks": {
		"SessionStart": [
			{
				"matcher": "startup",
				"hooks": [
					{
						"type": "command",
						"command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/session-start-audit.sh\"",
						"timeout": 10
					}
				]
			}
		],
		"PostToolUse": [
			{
				"matcher": "Edit|Write|MultiEdit",
				"hooks": [
					{
						"type": "command",
						"command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/check-edited-file.sh\"",
						"timeout": 90,
						"statusMessage": "A verificar lint e tipos..."
					}
				]
			}
		],
		"PreToolUse": [
			{
				"matcher": "Bash",
				"hooks": [
					{
						"type": "command",
						"command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/pre-deploy-gate.sh\"",
						"timeout": 600,
						"onFailure": "block",
						"statusMessage": "Pre-deploy gate: lint, tipos, testes e auditoria..."
					}
				]
			}
		]
	}
}
